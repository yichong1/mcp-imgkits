{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcp-imgkits-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Grey release is workers.dev only. Do NOT add a routes/custom_domain block
  // here. Any production hostname needs CTO / 小助理 approval first.
  "workers_dev": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // compress_image re-encodes with the Workers Images binding. No R2, no upstream.
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    // Grey-release self-test: allows workers.dev calls without X-Access-Channel.
    // Set to "0" once mcp-credit-gateway is wired to this Worker.
    "ALLOW_DIRECT_MCP": "1",
    "AI_BASE_URL": "https://ai.imgkits.com",
    "API_BASE_URL": "https://api.imgkits.com",
    "USA_BASE_URL": "https://usa.imgkits.com",
    "COLORIZE_PATH": "/api/deoldify",
    "UPSCALE_PATH": "/api/restoration",
    "CARTOONIZE_PATH": "/api/cartoonize",
    "CARTOONIZE_V2_PATH": "/api/cartoonize/v2",
    "SEGMENT_PATH": "/ai/segment",
    "OUTPAINT_PATH": "/ai/image-outpainting",
    "RESIZE_PATH": "/ai/change-img-size",
    // Documented only. erase_object is not registered and this path is never called.
    "ERASE_PATH": "/api/inpaint",
    "UPSTREAM_TIMEOUT_MS": "45000",
    "COST_COLORIZE_PHOTO": "2",
    "COST_UPSCALE_IMAGE": "2",
    "COST_REMOVE_BACKGROUND": "2",
    "COST_CARTOONIZE": "2",
    "COST_EXTEND_IMAGE": "2",
    "COST_RESIZE_IMAGE": "1",
    "COST_COMPRESS_IMAGE": "1"
  }
  // Public upstreams need no Bearer. Do not add UPSTREAM_API_TOKEN or any
  // frontend key. Optional GATEWAY_SHARED_SECRET is set with
  // `wrangler secret put` only when the gateway sends X-Gateway-Shared-Secret.
}

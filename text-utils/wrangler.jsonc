{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcp-text-utils",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Grey release is workers.dev only. Do NOT add a routes/custom_domain block.
  "workers_dev": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ALLOW_DIRECT_MCP": "1",
    "COST_CONVERT_TEXT_STYLE": "1",
    "COST_COUNT_TEXT": "1"
  }
  // No UPSTREAM secrets — pure algorithm Worker.
}
